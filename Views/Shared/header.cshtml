@using System.Collections
@inherits UmbracoViewPage
@{
    var startPage = Model.AncestorOrSelf<StartPage>();
    var children = startPage?.Children()
    .Where(x => x.Name != "SharedComponents");
    var contactPage = children?.FirstOrDefault(x => x.ContentType.Alias == "contact");
    var quotePage = children?.FirstOrDefault(x => x.ContentType.Alias == "quote");
    var siteName = startPage.Value("siteName");
}

<header class="header">
    <nav class="relative after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-px">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="relative flex h-16 items-center justify-between">

              
                <div class="logo flex shrink-0 items-center text-lg font-bold text-white">
                    <a href="/">@siteName</a>
                </div>

               
                @if (children != null)
                {
                    @await Html.PartialAsync("_DesktopMenu", children)
                }

               
                <div class="flex items-center">

                   
                    @if (quotePage != null)
                    {
                        var hideContactUs = quotePage.Value<bool>("UmbracoNaviHide");
                        var cMenutitle = quotePage.Value<string>("MenuTitle") ?? "Få offert";

                        if (hideContactUs == false)
                        {
                            <div class="hidden sm:flex sm:items-center">
                                <a class="btn shadow-xs bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500" href="@quotePage.Url()">
                                    @cMenutitle
                                </a>
                            </div>
                        }
                    }

                    
                    <div class="ml-2 flex items-center sm:hidden">
                        <button type="button" command="--toggle" commandfor="mobile-menu" class="relative inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-white/5 hover:text-white focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-500">
                            <span class="sr-only">Öppna meny</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 in-aria-expanded:hidden"><path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6 not-in-aria-expanded:hidden"><path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </div>

                </div>

            </div>
        </div>

       
        @if (startPage != null)
        {
            @await Html.PartialAsync("_MobileMenu", startPage)
        }
    </nav>
</header>