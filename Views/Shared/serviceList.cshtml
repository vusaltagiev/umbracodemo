@using System.Collections
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;

@inherits UmbracoViewPage
@{
    var startPage = Model.AncestorOrSelf<StartPage>();
    var settingsPage = startPage?.Value<IPublishedContent>("settingsPage");
    var serviceList = settingsPage?.Value<List<IPublishedContent>>("serviceList");
}

<div class="grid grid-cols-1 gap-6 p-4 sm:grid-cols-2 lg:grid-cols-4">
    @if (serviceList != null && serviceList.Count() > 0)
    {
            @foreach (var service in serviceList)
            {
                var serviceHeadline = service.Value("Headline");
                var serviceImage = service.Value<IPublishedContent>("Image");
                var description = service.Value("Description");

            <div class="flex flex-row items-start gap-2 rounded-lg bg-white p-4 shadow-sm">

              
                <div class="flex h-16 w-16 shrink-0 items-center justify-center">
                    <img src="@serviceImage?.Url()" alt="@serviceHeadline" class="h-full w-full object-contain" />
                </div>

             
                <div class="flex flex-col space-y-1 text-left">
                    <h4 class="text-lg leading-normal font-semibold text-gray-900">@serviceHeadline</h4>
                    <p class="text-sm text-gray-600">
                        @description
                    </p>
                </div>

            </div>
            }
    }
</div>
