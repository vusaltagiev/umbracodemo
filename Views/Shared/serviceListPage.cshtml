@* @using System.Collections
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels; *@
@using Umbraco.Cms.Core.Models.Blocks;
@using Umbraco.Cms.Web.Common.PublishedModels;

@inherits UmbracoViewPage
@{
    var startPage = Model.AncestorOrSelf<StartPage>();
    var settingsPage = startPage?.Value<IPublishedContent>("settingsPage");
    var serviceListPage = settingsPage?.Value<List<IPublishedContent>>("serviceListPage");

    // var heroBlockList = Model.Value<BlockListModel>("Hero");
    // var heroContent = heroBlockList?.FirstOrDefault()?.Content;
}

@await Html.PartialAsync("~/Views/Shared/_HeroComponent.cshtml", Model)

<div class="grid grid-cols-1 gap-6 p-4 sm:grid-cols-2 lg:grid-cols-4">
    @if (serviceListPage != null && serviceListPage.Count() > 0)
    {
        @foreach (var service in serviceListPage)
         {
                var serviceHeadline = service.Value("Headline");
                var serviceImage = service.Value<IPublishedContent>("Image");
                var description = service.Value("Description");

            <div class="flex flex-col items-center rounded-lg bg-white p-4 text-center shadow-sm">
                    <div class="mb-4 flex h-20 w-20 items-center justify-center">
                        <img src="@serviceImage?.Url()">
                    </div>
                  
                <div class="flex w-full flex-col items-center space-y-2">
                    <h4 class="text-lg font-semibold text-gray-900">@serviceHeadline</h4>
                    <p class="mt-4 text-sm text-gray-600">
                        @description
                    </p>
                </div>
            </div>
         }
    }
</div>
