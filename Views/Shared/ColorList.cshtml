@using Umbraco.Cms.Web.Common.PublishedModels;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inherits UmbracoViewPage
@{
    Layout = null;
    var startPage = Model.AncestorOrSelf<StartPage>();
    var settingsPage = startPage?.Value<IPublishedContent>("settingsPage");
    var colorListContainerNode = settingsPage?.Value<IPublishedContent>("colorListContainer");
    var colorList = colorListContainerNode?.Children();
}

<div class="grid grid-cols-4 gap-x-8 gap-y-4" style="border:2px solid blue;">
    @if (colorList != null && colorList.Any()) 
    {
        @foreach (var colors in colorList)
        {
        var colersItem = colors.Children();
            <div class="mr-2 grid items-start gap-4">
                <div class="flex flex-col space-y-1">
                @if (colersItem != null && colersItem.Any())
                {
                    @foreach (var color in colersItem)
                        {
                        var foilColor = color.Value("foilColors");
                        var colorImage = color.Value<IPublishedContent>("foilImage");
                            <div class="flex flex-col space-y-2">
                                <div class="w-full overflow-hidden rounded-lg border border-gray-200">
                                    <img src="@colorImage?.Url()" class="h-auto w-full object-cover" style="max-width:300px;">
                              </div>
                                <div class="flex flex-col">
                                    <h6 class="text-sm font-medium text-gray-600" style="border:2px solid blue">@foilColor</h6>
                                    <h5 class="text-base font-bold text-gray-900">@color.Name</h5>
                                    <h4>@colors.Name</h4>
                              </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>
