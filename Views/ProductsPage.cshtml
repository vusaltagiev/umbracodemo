@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<umbracodemo.Models.ProductsPageViewModel>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "master.cshtml";
    var headline = Model.Headline;
}

<div class="section container">
    @if (!string.IsNullOrEmpty(headline))
    {
        <h1>@headline</h1>
    }
    <div>
        @await Html.PartialAsync("~/Views/Partials/ProductList.cshtml", Model.NorthwindProducts)
    </div>
</div>